import { NextRequest, NextResponse } from 'next/server';
import { getIronSession } from 'iron-session';
import { sessionOptions, SessionData } from '@/lib/auth/session';

export async function middleware(request: NextRequest) {
  const { pathname } = request.nextUrl;
  const response = NextResponse.next();

  // Получаем сессию. В middleware iron-session работает напрямую с запросом и ответом.
  const session = await getIronSession<SessionData>(
    request,
    response,
    sessionOptions
  );

  // 1. Защита админки (/admin/*), кроме страницы входа
  if (pathname.startsWith('/admin') && !pathname.startsWith('/admin/login')) {
    if (!session.userId) {
      return NextResponse.redirect(new URL('/admin/login', request.url));
    }

    // Разрешаем вход только персоналу (не собственникам)
    const staffRoles = ['accountant', 'chairman', 'admin', 'moderator', 'electrician'];
    if (!session.role || !staffRoles.includes(session.role)) {
      return NextResponse.redirect(new URL('/admin/login', request.url));
    }
  }

  // 2. Защита личного кабинета собственника (/app/*)
  if (pathname.startsWith('/app')) {
    if (!session.userId) {
      return NextResponse.redirect(new URL('/login', request.url));
    }

    // Если зашел не собственник, а персонал — отправляем в админку
    if (session.role !== 'owner') {
      return NextResponse.redirect(new URL('/admin', request.url));
    }
  }

  // 3. Если авторизованный персонал пытается зайти на /login — редирект в /admin
  if (pathname === '/login' && session.userId && session.role !== 'owner') {
    return NextResponse.redirect(new URL('/admin', request.url));
  }

  // 4. Если авторизованный собственник пытается зайти на /admin/login — редирект в /app
  if (pathname === '/admin/login' && session.userId && session.role === 'owner') {
    return NextResponse.redirect(new URL('/app', request.url));
  }

  return response;
}

// Указываем, для каких путей применять этот middleware
export const config = {
  matcher: ['/app/:path*', '/admin/:path*', '/login'],
};